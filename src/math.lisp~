(defun make-finite-set (members &key (test #'eql) (type 'number))
  (check-type test function)
  (check-type type (member number list string symbol char))
  (multiple-value-bind (value position)
      (has-no-duplicates-p members :test test) 
    (unless value
      (error "MEMBERS must be a list without duplicates! Duplicate element \"~S\" at position ~d"
	     (elt members position) position))
    
    (make-math-set :finite t
		   :kind :domain
		   :list members
		   :documentation (list->math-notation members type))))

(defun make-finite-predicate-set (predicate &key (test #'eql))
  (check-type test function)
  (check-type predicate function)
  (make-math-set :finite t
		   :kind :predicate
		   :predicate predicate))

;;some finite sets
(defparameter *empty-set* (make-finite-set '()))

(defun emptyp (set)
  (and (math-set-finite set)
       (eql :domain (math-set-kind set))
       (null (math-set-list set))))

(defun make-infinite-set (predicate &optional (documentation ""))
  (check-type predicate function)
  (make-math-set :finite nil
		 :kind :predicate
		 :predicate predicate
		 :documentation documentation))

;;some finite sets
(defparameter *N* (make-infinite-set
		   (lambda (x) (and (integerp x) (>= x 0)))
		   "{x ∈ Z | x ≥ 0}"))
(defparameter *Z* (make-infinite-set #'integerp))
(defparameter *R* (make-infinite-set #'realp))


;;;UTILITIES
(defun set->list (s)
  (unless (math-set-finite s)
    (error "set->list applies only at finite sets!"))
  (unless (eql :domain (math-set-kind s))
    (error "Set is defined with a predicate!"))
  (math-set-list s))

(defun list->set (lst)
      (make-finite-set lst))

(defun belongs (x set &key (test #'eql))
  (if (math-set-finite set)
      (when (member x (set->list set) :test test) t)
      (funcall (math-set-predicate set) x)))

(defun equal-sets (s1 s2 &key (test #'eql))
  (and (sub-set-p s1 s2 :test test)
       (sub-set-p s2 s1 :test test)))

(defun is-domain-p (set)
  (eq :domain (math-set-kind set)))


(defun sub-set-finite-p (s1 s2 &key (test #'eql))
  (cond
    ;; domain ⊆ domain
    ((and (is-domain-p s1)
          (is-domain-p s2))
     (let ((l1 (set->list s1))
           (l2 (set->list s2)))
       (reduce
        (lambda (acc x)
          (and acc
               (not (null (member x l2 :test test)))))
        l1
        :initial-value t)))

    ;; domain ⊆ predicate
    ((and (is-domain-p s1)
          (not (is-domain-p s2)))
     (let ((l1 (set->list s1))
           (predicate (math-set-predicate s2)))
       (reduce
        (lambda (acc x)
          (and acc
               (funcall predicate x)))
        l1
        :initial-value t)))

    ;; predicate ⊆ predicate
    ((and (not (is-domain-p s1))
          (not (is-domain-p s2)))
     (error
      "Can't determine subset relation between two predicate sets."))

    ;; predicate ⊆ domain
    (t
     (error
      "Can't determine subset relation between a predicate set and a domain set."))))


(defun sub-set-of-infinite-p (s1 infinite-s)
  (let ((l1 (set->list s1))
	(predicate (math-set-predicate infinite-s)))
    (reduce (lambda (acc x) (and acc (funcall predicate x))) l1 :initial-value t)))

(defun sub-set-p (s1 s2 &key (test #'eql))
  (cond
    ;; explicit list ⊆ explicit list
    ((and (is-domain-p s1)
          (is-domain-p s2))
     (sub-set-finite-p s1 s2 :test test))

    ;; explicit list ⊆ predicate
    ((and (is-domain-p s1)
          (not (is-domain-p s2)))
     (sub-set-of-infinite-p s1 s2))

    ;; predicate ⊆ anything
    (t
     (error
      "Can't determine whether a predicate set is a subset."))))


