(defpackage :math
	    (:use :cl)
	    (:export
	     :*empty-set*
	     :*N*
	     :*Z*
	     :*R*
	     :has-no-duplicates-p
	     :make-finite-set
	     :math-set-finite
	     :make-infinite-set
	     :belongs
	     :set->list
	     :list->set
	     :belongs
	     :equal-sets
	     ))

(in-package :math)


(defstruct (math-set (:predicate nil))
  finite 
  (kind :domain :type (member :domain :predicate))
  (list nil :type list)
  (predicate nil :type (or null function))
  (documentation "" :type string))

(defun has-no-duplicates-p (lst &key (test #'eql))
  (if (not (listp lst))
      nil
       (labels ((helper (ls container n)
		  (cond
		    ((null ls) t)
		    ((member (first ls) container :test test) (values nil n))
		    (t (helper (rest ls) (cons (first ls) container) (1+ n))))))
	 (helper (rest lst) (list (first lst)) 1))))


(defun list->math-notation (lst &optional (type 'number))
  "Converts a list of members to mathematical set notation.
TYPE determines how each member is printed."
  (let ((formatter
          (case type
            ((number)
             (lambda (x)
               (format nil "~a" x)))

            ((symbol)
             (lambda (x)
               (symbol-name x)))

            ((string)
             (lambda (x)
               (format nil "\"~a\"" x)))

	    ((char)
	     (lambda (x)
               (format nil "'~a'" x)))
	    
            ((list)
             (lambda (x)
               (format nil "~a" x)))

            (otherwise
             (error "Unknown member type: ~S" type)))))

    (format nil
            "{~{~a~^, ~}}"
            (mapcar formatter lst))))

