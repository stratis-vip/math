(test belongs
  (let ((set-1234 (make-finite-set '(1 2 3 4)))
	(set-strings (make-finite-set '("a" "b") :test #'string=)))
    (check (belongs 1 set-1234))
    (check (belongs "a" set-strings :test #'string=))
